filters:
  and:
    - file.ext == "md"
views:
  - type: table
    name: Overview
    filters:
      and:
        - file.folder != "_inspo"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - file.tags
      - tags
      - draft
    sort:
      - property: dg-home
        direction: ASC
      - property: dg-publish
        direction: ASC
      - property: tags
        direction: ASC
    columnSize:
      file.tags: 227
      note.tags: 224
      note.draft: 78
  - type: table
    name: Published Notes
    filters:
      and:
        - draft != true
        - file.folder != "_inspo"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - draft
      - file.tags
      - tags
      - related
    sort:
      - property: draft
        direction: ASC
    columnSize:
      note.draft: 99
      file.tags: 236
      note.tags: 224
  - type: table
    name: test
    filters:
      and:
        - file.folder != "_inspo"
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - draft
      - file.tags
      - tags
      - related
    sort:
      - property: dg-home
        direction: ASC
      - property: dg-publish
        direction: ASC
      - property: tags
        direction: ASC
    columnSize:
      file.tags: 227
      note.tags: 224
